{
  Escribir un algoritmo que sume dos números: A = 4  B = 3
}

algoritmo SEC01;

variables 
 A, B, C son enteros;

inicio
  // Se le asignan los valores de las variables  "A" y "B"
  A = 4;
  B = 3;
  // Se le asigna a "C" el resultado de la suma de "A" y "B" 
  C = A + B;
  // Muestra el valor de "C" en la consola
  escribir C; 
final
