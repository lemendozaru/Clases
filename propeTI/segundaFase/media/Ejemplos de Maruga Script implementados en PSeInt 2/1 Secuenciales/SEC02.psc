
//  Escribir un algoritmo que sume dos números entrados por el usuario


Proceso SEC02
	
	Definir A, B Como Enteros;
	
	Escribir "Introduzca un número: ";
	Leer A;
	Escribir "Introduzca otro número: ";
	Leer B;
	// Muestra el valor de la suma  en la consola
	Escribir "El resultado es: ", A + B;
finProceso
