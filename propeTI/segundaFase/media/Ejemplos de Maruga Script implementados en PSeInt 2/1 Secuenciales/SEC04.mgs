{
 Escribir un algoritmo que sume, reste, multiplique y divida dos números REALES
}

algoritmo SEC04;

variables 
  A, B son reales;
  S, R, D, M son reales;
 
inicio
  escribir "Introduzca un número real: ";
  leer A;
  escribir "Introduzca otro número real: ";
  leer B;
  // Realizar las operaciones
  S = A + B;
  R = A - B;
  M = A * B;
  // División real
  D = A / B;
  // Muestra los resultados de las operaciones
  escribir "La suma es: ", S, nl;
  escribir "La resta es: ", R, nl;
  escribir "La multiplicación es : ", M, nl;
  escribir "La división es: ", D, nl;
final


