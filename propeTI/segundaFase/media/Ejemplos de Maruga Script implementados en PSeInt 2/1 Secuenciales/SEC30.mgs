{
 Escribir el algoritmo para conocer los valores finales de las variables 
 contenidas en las siguientes expresiones:

 A = A + 3
 B = B + 4 - A
 C = A + B + C
 A = A + C
 C = C + 3 - B + 2
}

algoritmo SEC30;

variables 
  A, B, C son reales;
  
inicio
  escribir "Introduzca el valor de A: ";
  leer A;
  escribir "Introduzca el valor de B: ";
  leer B;
  escribir "Introduzca el valor de C: ";
  leer C;
  A = A + 3;
  B = B + 4 - A;
  C = A + B + C;
  A = A + C;
  C = C + 3 - B + 2;
  escribir "El valor final de A es: ", A, nl;
  escribir "El valor final de B es: ", B, nl;
  escribir "El valor final de C es: ", C, nl;
final


     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
