
//	Escribir un algoritmo para obtener la longitud de una cadena utilizando la 
//	función LONGITUD(L), que devuelve la longitud de la Cadena L.

Proceso LIT05

  Definir L Como Cadena;

  Escribir "Introduzca una frase: ";
  Leer L;
  Escribir "La longitud de la frase es: ", longitud(L);
FinProceso
