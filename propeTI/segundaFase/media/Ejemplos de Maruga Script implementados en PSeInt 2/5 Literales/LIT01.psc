	
// Escribir un algoritmo que sume dos Cadenas. Los datos vienen en el cuerpo del 
// ejercicio.

Proceso LIT01

  Definir Titulo1, Titulo2, Titulo3 Como Cadenas;

  Titulo1 <- "Alien"; 
  Titulo2 <- "Blade"; 
  Titulo3 <- "Runner";
  Escribir "TÍTULOS DE PELÍCULAS";
  Escribir Titulo1;
  // Concatenar las literales con "+"
  Escribir concatenar(Concatenar(Titulo2," "),Titulo3); //En perfil taller de informática otra forma podría ser: Titulo2 + " " + Titulo3;  
FinProceso
