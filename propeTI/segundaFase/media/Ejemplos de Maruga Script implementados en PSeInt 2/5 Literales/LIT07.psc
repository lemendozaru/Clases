
// Escribir un algoritmo para transformar la literal "PSeInt" en la 
// literal "PSEINT" y "pseint. Utilizar las funciones
//  MAYUSCULAS(Cadenas) y MINUSCULAS(Cadenas)


Proceso LIT07


  Definir L, SL Como Cadenas;
  

  L <- "PSeInt";
  Escribir "Este lenguaje es: ", mayusculas(L);
  Escribir "Este lenguaje es: ", minusculas(L);
FinProceso