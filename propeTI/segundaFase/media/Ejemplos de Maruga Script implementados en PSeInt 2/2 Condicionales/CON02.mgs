{
 Escribir un algoritmo que detecte si el usuario ha introducido tres números
 en orden ascendente.
}

algoritmo CON02;

variables 
  N1, N2, N3 son reales;
  
inicio
  escribir "Introduzca un número: ";
  leer N1;
  escribir "Introduzca otro número: ";
  leer N2;
  escribir "Introduzca otro número: ";
  leer N3;
  si (N2 > N1) y (N3 > N2) entonces 
    escribir "Los números se han introducido en orden ascendente", nl
  sino
    escribir "Los números no se han introducido en orden ascendente", nl
final


     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
     
